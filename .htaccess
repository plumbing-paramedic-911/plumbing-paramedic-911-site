# ────────────────────────────────────────────────────────────
# Plumbing Paramedic 911 — Apache config (Namecheap / cPanel)
# ────────────────────────────────────────────────────────────

DirectoryIndex index.html
AddDefaultCharset UTF-8
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force one canonical origin in a single hop: HTTPS + non-www.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.plumbingparamedic911\.com$ [NC]
  RewriteRule ^ https://plumbingparamedic911.com%{REQUEST_URI} [L,R=301]

  # Remove explicit index.html from directory URLs.
  RewriteRule ^(.+/)index\.html$ /$1 [L,R=301]
  RewriteRule ^index\.html$ / [L,R=301]

  # Exact legacy flat HTML URLs still appearing in search indexes.
  RewriteRule ^about\.html$ /about/ [L,R=301,NC]
  RewriteRule ^contact\.html$ /contact/ [L,R=301,NC]
  RewriteRule ^services\.html$ /services/ [L,R=301,NC]
  RewriteRule ^reviews\.html$ /reviews/ [L,R=301,NC]
  RewriteRule ^financing\.html$ /financing/ [L,R=301,NC]
  RewriteRule ^pricing\.html$ /pricing/ [L,R=301,NC]
  RewriteRule ^faq\.html$ /faq/ [L,R=301,NC]

  RewriteRule ^services/emergency-plumbing\.html$ /services/24-7-emergency-plumbing/ [L,R=301,NC]
  RewriteRule ^services/water-heater-repair\.html$ /services/water-heater-repair-replacement/ [L,R=301,NC]
  RewriteRule ^services/fixture-installation\.html$ /services/plumbing-fixture-installation-repair/ [L,R=301,NC]
  RewriteRule ^services/backflow-testing\.html$ /services/backflow-prevention-testing/ [L,R=301,NC]
  RewriteRule ^services/well-pump-repair\.html$ /services/well-pump-repair/ [L,R=301,NC]
  RewriteRule ^services/drain-cleaning\.html$ /services/drain-cleaning/ [L,R=301,NC]
  RewriteRule ^services/leak-detection\.html$ /services/leak-detection/ [L,R=301,NC]
  RewriteRule ^services/commercial-plumbing\.html$ /services/commercial-plumbing/ [L,R=301,NC]

  RewriteRule ^service-areas/abbeville-sc\.html$ /service-areas/abbeville-sc/ [L,R=301,NC]
  RewriteRule ^service-areas/greenwood-sc\.html$ /service-areas/greenwood-sc/ [L,R=301,NC]
  RewriteRule ^service-areas/anderson-sc\.html$ /service-areas/anderson-sc/ [L,R=301,NC]
  RewriteRule ^service-areas/laurens-sc\.html$ /service-areas/laurens-sc/ [L,R=301,NC]
  RewriteRule ^service-areas/mccormick-sc\.html$ /service-areas/mccormick-sc/ [L,R=301,NC]
  RewriteRule ^service-areas/ninety-six-sc\.html$ /service-areas/ninety-six-sc/ [L,R=301,NC]
  RewriteRule ^service-areas/calhoun-falls-sc\.html$ /service-areas/calhoun-falls-sc/ [L,R=301,NC]
  RewriteRule ^service-areas/due-west-sc\.html$ /service-areas/due-west-sc/ [L,R=301,NC]

  # Old query-string navigation routes.
  RewriteCond %{QUERY_STRING} ^page=pricing$ [NC]
  RewriteRule ^$ /pricing/? [L,R=301]
  RewriteCond %{QUERY_STRING} ^page=about$ [NC]
  RewriteRule ^$ /about/? [L,R=301]
  RewriteCond %{QUERY_STRING} ^page=contact$ [NC]
  RewriteRule ^$ /contact/? [L,R=301]
  RewriteCond %{QUERY_STRING} ^page=services-index$ [NC]
  RewriteRule ^$ /services/? [L,R=301]
  RewriteCond %{QUERY_STRING} ^page=areas-index$ [NC]
  RewriteRule ^$ /service-areas/? [L,R=301]

  # Add trailing slash to directory-style URLs, but never to real files.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^ /%{REQUEST_URI}/ [L,R=301,NE]
</IfModule>

# ────────────────────────────────────────────────────────────
# Performance: caching + compression
# ────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=()"
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header set Cross-Origin-Resource-Policy "same-site"
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
  Header set Content-Security-Policy "upgrade-insecure-requests; default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|avif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  Header unset X-Powered-By
  Header unset Server
</IfModule>

ServerSignature Off

<FilesMatch "(^\.|\.(env|git|gitignore|gitattributes|md|py|sh|bak|swp|log|sql|toml|yml|yaml|lock|ini|conf|htaccess|htpasswd)$)">
  Require all denied
</FilesMatch>
<IfModule mod_alias.c>
  RedirectMatch 403 (?i)/\.(?!well-known/)
</IfModule>

AddType application/manifest+json .webmanifest
AddType image/svg+xml             .svg
AddType image/webp                .webp
AddType image/avif                .avif

ErrorDocument 404 /404.html
